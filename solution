# Lösung der Zusatzaufgaben (pro_*)
pro_01. ls -l /usr/bin/passwd -> "s" statt "x" beim Besitzer (SUID-Bit). Das Programm läuft
        mit den Rechten des Besitzers (root), sonst könnte ein normaler User /etc/shadow nicht ändern.
pro_02. SUID (Set User ID). find / -perm -4000 -type f 2>/dev/null | wc -l   (Anzahl hängt vom Image ab)
pro_03. ls /gibtesnicht; echo $?  -> 2 ("serious trouble", z.B. Datei nicht gefunden; 1 = "minor problems")
        true -> 0, false -> 1
pro_04. ls /gibtesnicht /etc/hostname 2> beschwerden
pro_05. 1) chmod +x skript.sh  2) name=$(whoami) (keine Leerzeichen um "=")  3) if [ ... ]; then
pro_06. ls -ld stein -> dr-xr-xr-x: Zum Löschen braucht man Schreibrecht auf den ORDNER (Stein),
        nicht auf die Datei. chmod u+w stein && rm stein/zettel
pro_07. lsattr erster_dollar -> Attribut "i" (immutable). Kann nur mit chattr -i entfernt werden; dafür
        braucht man CAP_LINUX_IMMUTABLE, das im Container fehlt -> auch sudo hilft nicht.
sidequest01. /usr/games/fortune | /usr/games/cowsay
pro_08. ./qualle.sh &   ->  jobs -l / pgrep -a qualle / ps aux | grep qualle
        kill PID -> wird ignoriert (SIGTERM abgefangen); kill -USR1 PID -> Erfolgsmeldung
        Bonus: kill -9 PID (SIGKILL kann nicht abgefangen werden, der Kernel beendet den Prozess direkt)
pro_09. file flaschenpost (oder od -c flaschenpost | head -1 -> gzip) ; tar xzf flaschenpost ; base64 -d kiste/brief
pro_10. 1) grep -c "Failed password" auth.log                                   -> 93
        2) grep "Failed password" auth.log | awk '{print $(NF-3)}' | sort | uniq -c | sort -n | tail -1
                                                                                   -> 203.0.113.42 (58x)
        3) grep "Failed password" auth.log | grep 203.0.113.42 | awk '{print $(NF-5)}' | sort | uniq -c | sort -n | tail -1
                                                                                   -> krabs (24x)
        4) grep Accepted auth.log | grep 203.0.113.42  -> ja, als "thaddaeus" (Passwort erraten!)
        5) grep 203.0.113.42 adressbuch                 -> Abfalleimer (Plankton)

